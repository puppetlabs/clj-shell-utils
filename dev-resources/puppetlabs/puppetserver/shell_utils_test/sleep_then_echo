#!/usr/bin/env sh

# Sleeps for approximately $1 seconds, in 1-second increments, then echoes
# "finished". Looping in small increments (rather than a single long sleep)
# bounds how long a forked `sleep` grandchild can outlive this script's own
# process if it is killed: at most ~1 second, rather than up to $1 seconds.
# That matters for tests that kill this script via a timeout, since a
# grandchild process that inherited this script's stdout/stderr file
# descriptors will keep those pipes open -- and any reader blocked on them --
# until it exits on its own, however long that takes.
seconds=$1
i=0
while [ "$i" -lt "$seconds" ]; do
  sleep 1
  i=$((i + 1))
done
echo "finished"
